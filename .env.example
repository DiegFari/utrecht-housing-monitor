# LOCAL USE ONLY. On GitHub, add SMTP_USER, SMTP_PASSWORD and EMAIL_TO
# as Actions Secrets instead. Never upload your .env file.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
# A Google app password, NOT your normal Google password.
SMTP_PASSWORD=replace-with-your-16-character-app-password
EMAIL_TO=your-address@gmail.com

CHECK_INTERVAL_SECONDS=300
STATE_FILE=data/state.json
# The two settings above apply only to the legacy Canvas-only monitor.py.
# housing.py uses data/housing-state.json and checks once per Actions run.
# Use chrome if Google Chrome is already installed on your Mac.
# On the server, leave this as chromium and install Playwright's Chromium.
BROWSER_CHANNEL=chromium
